# Use este Dockerfile APENAS se o Root Directory do Railway for a RAIZ do repo (não whatsapp-gateway).
# Recomendado: Root Directory = whatsapp-gateway e use whatsapp-gateway/Dockerfile

FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ \
  && git config --system --add url."https://github.com/".insteadOf "ssh://git@github.com/" \
  && git config --system --add url."https://github.com/".insteadOf "git@github.com:" \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY whatsapp-gateway/package.json whatsapp-gateway/package-lock.json ./
RUN npm ci --omit=dev --omit=optional

COPY whatsapp-gateway/server.js ./

ENV NODE_ENV=production

EXPOSE 3847

CMD ["node", "server.js"]
